TOOL_DIRS = tools/funkinisopak tools/funkinarcpak tools/funkinchartpak \
	tools/funkinpicopak tools/funkintimconv tools/funkinchrpak \
	tools/psxavenc tools/xainterleave tools/funkinmultitool

TOOLS = $(foreach tool,$(TOOL_DIRS),$(tool)/$(notdir $(tool)).exe)

all: $(TOOLS)

$(TOOLS):
	cd $(dir $@) && $(MAKE)

clean:
	rm -f $(TOOLS)
	@for tool in $(TOOL_DIRS); do \
		$(MAKE) -C $$tool clean 2>/dev/null || true; \
	done

.PHONY: all clean
